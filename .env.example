# Last.fm API Configuration (for Spotify scrobble integration)
LASTFM_API_KEY=your_lastfm_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable Key (juga dikenal sebagai Anon Key di dokumentasi lama Supabase)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Vercel Web Analytics Integration (Admin Dashboard)
# 1. Personal Access Token: https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=
# 2. Project ID: Vercel Project Settings > General (e.g. prj_xxxx)
VERCEL_PROJECT_ID=
# 3. Team ID: Optional, only needed if deployed under a team account
VERCEL_TEAM_ID=
